# Copy to .env and fill in. Never commit .env.
# Python scripts read ./.env ; the web app reads web/.env.local (symlinked to ../.env).

# --- OpenRouter (generation) ---
OPENROUTER_API_KEY=
# Verify the slug with: curl -s https://openrouter.ai/api/v1/models | grep -i deepseek
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# --- TypeSafe Jev (judgments) ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler string (port 5432), used by the LangGraph checkpointer and ingest.
SUPABASE_DB_URL=

# --- App secrets (generated locally; safe to keep or regenerate) ---
IP_HASH_SALT=
EVAL_KEY=

# --- Embeddings (OpenRouter; must match between ingest and the app) ---
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIMENSIONS=384

# --- Limits ---
DAILY_QUOTA_PER_IP=20
GLOBAL_DAILY_CAP=500
MAX_JEV_REQUESTS_PER_QUERY=90

# --- Deployment ---
APP_URL=http://localhost:3000
# Base URL the eval runner and nightly workflow call (your Vercel URL in production)
EVAL_BASE_URL=http://localhost:3000
